{
  "name": "pug-ide",
  "version": "0.8.0",
  "license": "MIT",
  "author": "ElMaxter99 (https://github.com/ElMaxter99)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElMaxter99/pugIDE.git"
  },
  "description": "PugIDE - Visual Pug/Jade development environment with smart data generation",
  "type": "module",
  "scripts": {
    "prestart": "node scripts/bundle-sass.mjs",
    "start": "ng serve",
    "build": "ng build",
    "prebuild:prod": "node scripts/bundle-sass.mjs && node scripts/validate-build.js",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch",
    "test": "ng test",
    "prelint": "node scripts/subset-icons.mjs --check && node scripts/bundle-sass.mjs",
    "lint": "ng lint",
    "test:e2e": "node --test e2e/editor-utils.test.ts && node e2e/build.mjs && node e2e/scenarios.mjs",
    "fonts:icons": "node scripts/subset-icons.mjs",
    "bundle:pug": "node scripts/bundle-pug.mjs",
    "bundle:sass": "node scripts/bundle-sass.mjs",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release:check": "node scripts/check-release.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "prebuild": "node scripts/bundle-sass.mjs && node scripts/validate-build.js",
    "test:ui": "node ui-tests/run.mjs",
    "perf": "node scripts/perf.mjs",
    "test:unit": "node test/unit/build.mjs && node --test test/unit/*.test.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:guide": "node scripts/release-guide.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.5",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/service-worker": "22.2.5",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@vercel/analytics": "^2.0.1",
    "fflate": "^0.8.3",
    "less": "^4.9.1",
    "monaco-editor": "0.52.2",
    "prettier": "^3.4.0",
    "pug": "^3.0.4",
    "pug-lexer": "^5.0.1",
    "pug-parser": "^6.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@types/node": "^22.0.0",
    "angular-eslint": "^22.6.0",
    "assert": "^2.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "material-symbols": "0.48.3",
    "path-browserify": "^1.0.1",
    "playwright-core": "1.56.1",
    "sass": "^1.105.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
