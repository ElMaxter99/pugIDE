extends layout

block content
  h1 PugIDE - Demo Completo de Funcionalidades

  //- Includes (deben ir antes de usar los mixins)
  include components/card.pug
  include components/navbar.pug

  //- ===================== SECCION 1: VARIABLES BASICAS =====================
  h2 1. Variables Básicas (interpolación, textos, atributos)
  p Hola, #{nombre}. Tu email es #{email}
  p Edad: #{edad} años
  p
    | Activo:
    strong= activo ? 'Sí' : 'No'
  img(src=avatar width="64" height="64" style="border-radius:50%")

  //- ===================== SECCION 2: CONDICIONALES =====================
  h2 2. Condicionales (if / unless / else)
  if rol === 'admin'
    p.badge-admin Escudo: Eres administrador
  else if rol === 'editor'
    p.badge-editor Lapiz: Eres editor
  else
    p.badge-user Persona: Eres usuario regular

  unless desactivado
    p Checkmark: Cuenta activa
  else
    p X: Cuenta desactivada

  //- ===================== SECCION 3: CADA / ITERACIONES =====================
  h2 3. Iteraciones (each / while)
  h3 Lista de hobbies:
  ul
    each hobby in hobbies
      li= hobby

  h3 Usuarios del sistema:
  table
    thead
      tr
        th Nombre
        th Edad
        th Email
        th Rol
    tbody
      each usuario in usuarios
        tr
          td= usuario.nombre
          td= usuario.edad
          td= usuario.email
          td= usuario.rol || 'Invitado'

  //- ===================== SECCION 4: MIXINS DESDE INCLUDE =====================
  h2 4. Mixins incluidos desde componentes
  +card(noticia)
  +card(noticia2)
  +navbar(linksNav)

  //- ===================== SECCION 5: OBJETO VACIO =====================
  h2 5. Objeto Vacio ({}) - Edge Case
  .empty-object-demo
    p
      strong Prueba de objeto vacio:
      |  La variable <code>vacio</code> deberia ser <code>{}</code>
    if Object.keys(vacio).length === 0
      p Checkmark: <code>vacio</code> es un objeto vacio (no tiene propiedades)
    else
      p Advertencia: <code>vacio</code> tiene propiedades: #{JSON.stringify(vacio)}
    p
      | Acceso seguro a propiedad inexistente:
      = vacio.propiedadInexistente || 'Advertencia: undefined (no hay propiedad)'

  //- ===================== SECCION 6: ACCESO SEGURO (undefined/null) =====================
  h2 6. Valores null / undefined
  .undefined-safe
    p
      strong Valor null:
      = valorNulo !== null && valorNulo !== undefined ? valorNulo : 'null'
    p
      strong Valor undefined:
      = valorUndefined !== undefined && valorUndefined !== null ? valorUndefined : 'undefined'
    p
      | Entero opcional con fallback:
      = puntuacion !== null && puntuacion !== undefined ? puntuacion : 'Sin calificar'

  //- ===================== SECCION 7: STRING INTERPOLACION =====================
  h2 7. String Interpolation y Literals
  p
    | Mensaje personalizado:
    strong
      = 'Hola ' + nombre + ', tienes ' + edad + ' anyos y tu email es ' + email
  p
    | Texto escapado:
    = rawHtml
  p
    | Texto NO escapado (raw):
    != rawHtml

  //- ===================== SECCION 8: CODE EMBEBIDO =====================
  h2 8. Codigo JavaScript Embebido
  - var fecha = new Date()
  - var anio = fecha.getFullYear()
  p Anyo actual: #{anio}
  - var numeros = [10, 20, 30, 40, 50]
  p Suma de numeros: #{numeros.reduce((a, b) => a + b, 0)}

  //- ===================== SECCION 9: COMENTARIOS =====================
  // Este es un comentario HTML (visible en source)
  //- Este es un comentario Pug (no visible en HTML)

  //- ===================== SECCION 10: CASE/WHEN =====================
  h2 9. Case / When
  - var estado = 'completado'
  case estado
    when 'pendiente'
      p Reloj: Estado: Pendiente
    when 'procesando'
      p Circular: Estado: Procesando
    when 'completado'
      p Checkmark: Estado: Completado
    default
      p Interrogacion: Estado desconocido: #{estado}

  //- ===================== SECCION 11: ATRIBUTOS DINAMICOS =====================
  h2 10. Atributos Dinamicos
  - var urlClase = 'externo'
  a(href=urlTarget, class=urlClase, target='_blank' data-id=idPagina) Enlace dinamico
  div(class=['box', colorFondo])
  div(data-values=atributosData)&attributes(atributosExtra)

  //- ===================== SECCION 12: TIPOS DE DATOS JSON =====================
  h2 11. Tipos de Datos desde JSON
  p
    | String: #{stringVal}
  p
    | Numero (entero): #{intVal}
  p
    | Numero (float): #{floatVal}
  p
    | Booleano (true):
    = boolTrue ? 'verdadero' : 'falso'
  p
    | Booleano (false):
    = boolFalse ? 'verdadero' : 'falso'
  p
    | Array vacio:
    = arrayVacio.length === 0 ? '[] (vacio)' : arrayVacio.join(', ')
  p
    | Array con items:
    each item in arrayConItems
      span(style="margin-right:5px")= item

  //- ===================== SECCION 13: EXTENDS / BLOCK =====================
  h2 12. Herencia de plantillas (extends / block)
  p Esta página entera es <code>main.pug</code> extendiendo a <code>layout.pug</code> mediante <code>block content</code>.

  //- ===================== SECTION: LAYOUT & FOOTER =====================
  hr
  footer
    p PugIDE Demo - #{anio}
    p Copy; Todos los derechos reservados.
