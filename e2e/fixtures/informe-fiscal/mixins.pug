- var fmtMoney = function (value) { var n = Number(value || 0); if (!isFinite(n)) { n = 0; } return n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
- var fmtAmount = function (value) { var n = Number(value || 0); if (!isFinite(n)) { n = 0; } return fmtMoney(n) + ' €'; };
- var CHUNK_ROWS = 8;

mixin infBand()
  img.inf-band(src="/images/pdf/ejemplo/header.png", alt="Ejemplo")

mixin infEquityLines()
  span.inf-ml= 'Valor del'
  span.inf-ml= 'Patrimonio'
  span.inf-ml= 'a 31/12'

mixin infSharesLines()
  span.inf-ml
  span.inf-ml= 'Participaciones'
  span.inf-ml= '31/12'

mixin infTableHead()
  colgroup
    col(style="width:16.5%")
    col(style="width:1.0%")
  thead
    tr.inf-hr1
      td(colspan="1")
      td.inf-sh(colspan="2")
        span.inf-grpl= t('FISCAL_REPORT.GROUP_SAVINGS_BASE')
      td.inf-sh(colspan="2")
        span.inf-grpl= t('FISCAL_REPORT.GROUP_DECLARANT_ENTITY')
    tr.inf-hr2
      td.inf-c(colspan="2")= t('FISCAL_REPORT.COL_FUND')
      td.inf-r(colspan="1")= ' ' + t('FISCAL_REPORT.COL_ISIN')
      td.inf-c(colspan="1")= '  ' + t('FISCAL_REPORT.COL_RETENTION')
      td(colspan="1")
        +infEquityLines()
      td(colspan="2")
        +infSharesLines()

mixin infRow(infRow)
  tr.inf-tr
    td.inf-c(colspan="2")= infRow.fundName
    td.inf-c.inf-isin(colspan="1")= infRow.isin
    td.inf-sh.inf-c(colspan="1")= fmtAmount(infRow.gain)
    td.inf-sh.inf-c(colspan="1")= fmtAmount(infRow.loss)
    td.inf-c(colspan="1")= fmtAmount(infRow.retention)
    td.inf-r(colspan="1")= infRow.equity === null || infRow.equity === undefined ? '' : fmtAmount(infRow.equity)
    td.inf-r(colspan="2")= infRow.participations === null || infRow.participations === undefined ? '' : infRow.participations.toLocaleString('es-ES', { minimumFractionDigits: 3, maximumFractionDigits: 6 })
    td.inf-sh.inf-c(colspan="1")= infRow.declarantName
    td.inf-sh.inf-c.inf-nif(colspan="1")= infRow.declarantNif

mixin infTable(rows)
  - var chunkCount = Math.ceil(rows.length / CHUNK_ROWS);
  each ch in Array.from({ length: chunkCount }, function (_, i) { return i; })
    .inf-table-wrap
      if ch > 0
        +infBand()
      table.inf-table
        +infTableHead()
        tbody
          each infRow in rows.slice(ch * CHUNK_ROWS, (ch + 1) * CHUNK_ROWS)
            +infRow(infRow)

mixin infCover(reported)
  .inf-cover
    +infBand()
    p.inf-title
      span= t('FISCAL_REPORT.TITLE')
      span.inf-title-blue= ' ' + (reported.exercise || '')
    p.inf-greet= t('FISCAL_REPORT.GREETING')
    p.inf-field= reported.declaredClient.fullName
    p
    p.inf-field= reported.declaredClient.idCard

mixin infDividendRow(infDividend)
  tr.inf-tr
    td.inf-c= infDividend.fundName
    td.inf-c.inf-isin= infDividend.isin
    td.inf-c= infDividend.cifIic
    td.inf-r= fmtAmount(infDividend.gross)
    td.inf-r= (infDividend.retentionPct === null || infDividend.retentionPct === undefined ? '' : infDividend.retentionPct.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %')

mixin infDividendTable(dividends)
  - var chunkCount = Math.ceil(dividends.length / CHUNK_ROWS);
  each ch in Array.from({ length: chunkCount }, function (_, i) { return i; })
    .inf-table-wrap
      table.inf-table
        tbody
          each infDividend in dividends.slice(ch * CHUNK_ROWS, (ch + 1) * CHUNK_ROWS)
            +infDividendRow(infDividend)

mixin infFinancial(reported)
  .inf-financial
    +infBand()
    p.inf-section= t('FISCAL_REPORT.SECTION_TITLE')
    if !reported.rows || !reported.rows.length
      p.inf-intro= t('FISCAL_REPORT.NO_DATA')
    else
      +infTable(reported.rows)

mixin infDividends(reported)
  if reported.dividends && reported.dividends.length
    .inf-financial
      +infBand()
      p.inf-section= t('FISCAL_REPORT.DIVIDENDS_TITLE')
      +infDividendTable(reported.dividends)

mixin infClose(reported)
  .inf-close
    +infBand()
    p.inf-note= t('FISCAL_REPORT.FOOTER_NATIONAL_NOTE')
    p.inf-sp9!= '&nbsp;'
    .inf-brands
      img.inf-footer-logo(src="/images/pdf/ejemplo/logo.jpeg", alt="Ejemplo")

mixin infBody(reported)
  +infCover(reported)
  +infFinancial(reported)
  +infDividends(reported)
  +infClose(reported)
