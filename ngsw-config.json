{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "engine-bundles",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/pug-browser.js",
          "/assets/render-sandbox.js",
          "/assets/preview-runtime.js",
          "/assets/preview-host.html",
          "/assets/preview-host.js",
          "/assets/preview-frame.html",
          "/assets/render-frame.html",
          "/assets/parser-browser.js",
          "/assets/PugIDE.svg",
          "/assets/icons/pwa-*.png",
          "/assets/icons/favicon-*.png",
          "/assets/icons/apple-icon.png",
          "/assets/demo/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**"
        ]
      }
    }
  ]
}
