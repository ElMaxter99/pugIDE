{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "engine-bundles",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/pug-browser.js",
          "/assets/parser-browser.js",
          "/assets/PugIDE.svg",
          "/assets/icons/pwa-*.png",
          "/assets/icons/favicon-*.png",
          "/assets/icons/apple-icon.png",
          "/assets/demo/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "monaco-cdn",
      "urls": ["https://cdn.jsdelivr.net/npm/monaco-editor@*/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 600,
        "maxAge": "90d",
        "timeout": "5s"
      }
    },
    {
      "name": "google-fonts",
      "urls": [
        "https://fonts.googleapis.com/**",
        "https://fonts.gstatic.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 40,
        "maxAge": "365d",
        "timeout": "3s"
      }
    }
  ]
}
